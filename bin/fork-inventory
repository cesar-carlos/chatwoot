#!/usr/bin/env bash
set -euo pipefail

die() {
  echo "fork-inventory: $*" >&2
  exit 1
}

ROOT="$(git rev-parse --show-toplevel)"
OUTPUT="$ROOT/doc/fork-divergences.txt"

command -v rg >/dev/null 2>&1 || die 'ripgrep (rg) is required but not installed'

cd "$ROOT"
mkdir -p doc

# FORK: search source files of every format, including ERB, YAML and workflow definitions.
set +e
markers="$(rg -n --no-heading 'FORK:' app enterprise lib config custom db bin .github Gemfile Rakefile package.json)"
search_status=$?
set -e
(( search_status <= 1 )) || die 'ripgrep failed while collecting markers'

temp_output="$(mktemp "$ROOT/doc/.fork-divergences.XXXXXX")"
trap 'rm -f "$temp_output"' EXIT
{
  echo '# Fork divergences inventory'
  echo '# Generated by bin/fork-inventory; sorted by file and line'
  echo '# Search: FORK: in source and configuration files'
  echo
  if [[ -n "$markers" ]]; then
    printf '%s\n' "$markers" | LC_ALL=C sort -t: -k1,1 -k2,2n
  fi
} >"$temp_output"
mv "$temp_output" "$OUTPUT"

count=0
if [[ -n "$markers" ]]; then
  count="$(printf '%s\n' "$markers" | wc -l | tr -d ' ')"
fi
echo "Wrote $count FORK marker(s) to doc/fork-divergences.txt"
