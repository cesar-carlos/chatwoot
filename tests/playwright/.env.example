# Playwright Test Configuration

# Base URL for the Chatwoot instance under test
BASE_URL=http://localhost:3000

# Admin credentials — must be real users on the instance at BASE_URL (not defaults when testing remote)
TEST_USER_EMAIL=admin@chatwoot.com
TEST_USER_PASSWORD="Password123@#"

# Chatwoot account used for inbox creation tests
ACCOUNT_ID=8

# Evolution API (required for happy-path Evolution inbox tests)
# EVOLUTION_API_KEY must be the real AUTHENTICATION_API_KEY from your Evolution server
EVOLUTION_BASE_URL=https://evo.se7esistemassinop.com.br
EVOLUTION_API_KEY=your-evolution-authentication-api-key
