<%
  regular_features, premium_features = SuperAdmin::AccountFeaturesHelper.partition_features(field.data)
  premium_locked = ChatwootHub.pricing_plan == 'community'
  icons = SuperAdmin::AccountFeaturesHelper.feature_icons
  help_urls = SuperAdmin::AccountFeaturesHelper.feature_help_urls
  # FORK: self-hosted enterprise turns Advanced Assignment on with Assignment V2
  assignment_v2_enabled = field.data['assignment_v2']
  auto_advanced_assignment = assignment_v2_enabled && ChatwootApp.self_hosted_enterprise?
%>
<%= render "field", f: f, field: field, wide: true do %>
  <div data-filter-scope>
    <% if ChatwootApp.self_hosted_enterprise? %>
      <p class="text-n-slate-11 text-xs italic mb-4">
        Enabling Assignment V2 automatically enables Advanced Assignment on self-hosted enterprise accounts.
      </p>
      <% if auto_advanced_assignment %>
        <%= hidden_field_tag 'enabled_features[feature_advanced_assignment]', true %>
      <% end %>
    <% end %>

    <%= render "filter_bar", states: { all: t("super_admin.filters.all"), on: t("super_admin.features.selected"), off: t("super_admin.features.not_selected") }, bulk: true %>

    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3" data-filter-group>
      <% regular_features.each do |(feature_key, display_name), val| %>
        <%= render "check_tile", label: display_name, icon: icons[feature_key], help_url: help_urls[feature_key] do %>
          <%= check_box "enabled_features", "feature_#{feature_key}", { checked: val, class: ui(:checkbox) }, true, false %>
        <% end %>
      <% end %>
    </div>

    <div data-filter-group>
      <h3 class="text-xs font-medium uppercase tracking-wider text-n-slate-10 mb-2 mt-5"><%= t("super_admin.features.premium") %></h3>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
        <% premium_features.each do |(feature_key, display_name), val| %>
          <% checked = val || (feature_key == 'advanced_assignment' && auto_advanced_assignment) %>
          <% should_disable = premium_locked || (feature_key == 'advanced_assignment' && auto_advanced_assignment) %>
          <%= render "check_tile", label: display_name, icon: icons[feature_key], help_url: help_urls[feature_key], premium: true, disabled: should_disable do %>
            <%= check_box "enabled_features", "feature_#{feature_key}", { checked: checked, disabled: should_disable, class: ui(:checkbox) }, true, false %>
          <% end %>
        <% end %>
      </div>
    </div>

    <p class="hidden py-8 text-center text-n-slate-11" data-filter-empty><%= t("super_admin.features.no_match") %></p>
  </div>
<% end %>
